{
  "name": "news-scraper",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "db",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "astral-sh.ty"
      ]
    }
  },
  "postCreateCommand": "uv sync && uv run playwright install chromium"
}
